
import pygame
import random
import math

pygame.init()

# =====================================
# 1. KHOI TAO GAME
# =====================================
WIDTH = 400
HEIGHT = 600
GROUND_HEIGHT = 60
GROUND_Y = HEIGHT - GROUND_HEIGHT

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Flappy Bird")

clock = pygame.time.Clock()
FPS = 60

font = pygame.font.Font(None, 32)
big_font = pygame.font.Font(None, 48)

# Mau sac
SKY_TOP = (78, 190, 235)
SKY_BOTTOM = (180, 230, 250)

WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
GREEN = (100, 200, 80)

# =====================================
# 2. CAU HINH ONG
# =====================================
PIPE_WIDTH = 70
PIPE_GAP = 180
PIPE_INTERVAL = 1.5

PIPE_CAP_HEIGHT = 26
PIPE_CAP_EXTRA = 6

PIPE_COLOR = (115, 200, 45)
PIPE_LIGHT = (160, 230, 90)
PIPE_DARK = (65, 145, 30)
PIPE_OUTLINE = (45, 110, 25)

PIPE_SPEED_START = 180
PIPE_SPEED_MAX = 240
PIPE_SPEED_INCREASE = 2.0

# =====================================
# 3. TAO MAY
# =====================================
# Moi dam may gom nhieu hinh tron
clouds = []

for i in range(7):
    clouds.append({
        "x": random.randint(0, WIDTH),
        "y": random.randint(35, 330),
        "size": random.uniform(0.65, 1.15),
        "speed": random.uniform(12, 25)
    })


def draw_cloud(surface, x, y, size):
    """Ve dam may trang phong cach hoat hinh."""

    x = int(x)
    y = int(y)

    # Bong may xanh nhat
    shadow_color = (210, 239, 250)

    # Cac hinh tron tao thanh dam may
    circles = [
        (-25, 5, 17),
        (-10, -5, 21),
        (8, -12, 24),
        (27, -3, 19),
        (42, 5, 14),
        (8, 8, 22)
    ]

        # Ve bong may truoc
    for cx, cy, radius in circles:
            pygame.draw.circle(
                surface,
                shadow_color,
                (
                    int(x + cx * size),
                    int(y + cy * size + 4 * size)
                ),
                max(1, int(radius * size))
            )

        # Ve phan may trang
            for cx, cy, radius in circles:
             pygame.draw.circle(
                surface,
                WHITE,
                (
                    int(x + cx * size),
                    int(y + cy * size)
                ),
                max(1, int(radius * size))
            )


    def update_and_draw_clouds(surface, dt, move=True):
        """Cap nhat va ve may o phia sau."""

        for cloud in clouds:
            if move:
                cloud["x"] -= cloud["speed"] * dt

            # Khi may di het man hinh, dua may tro lai ben phai
            if cloud["x"] < -70 * cloud["size"]:
                cloud["x"] = WIDTH + random.randint(10, 100)
                cloud["y"] = random.randint(35, 330)
                cloud["size"] = random.uniform(0.65, 1.15)
                cloud["speed"] = random.uniform(12, 25)

            draw_cloud(
                surface,
                cloud["x"],
                cloud["y"],
                cloud["size"]
            )


    # =====================================
    # 4. VE NEN TRÒI
    # =====================================
    def draw_background(surface):
        # Nen troi chuyen mau tu tren xuong duoi
        for y in range(HEIGHT):
            ratio = y / HEIGHT

            r = int(SKY_TOP[0] * (1 - ratio) + SKY_BOTTOM[0] * ratio)
            g = int(SKY_TOP[1] * (1 - ratio) + SKY_BOTTOM[1] * ratio)
            b = int(SKY_TOP[2] * (1 - ratio) + SKY_BOTTOM[2] * ratio)

            pygame.draw.line(
                surface,
                (r, g, b),
                (0, y),
                (WIDTH, y)
            )


    # =====================================
    # 5. VE THAN ONG
    # =====================================
    def draw_pipe_body(surface, x, y, width, height):
        if height <= 0:
            return

        x = int(x)
        y = int(y)
        height = int(height)

        # Vien ngoai
        pygame.draw.rect(
            surface,
            PIPE_OUTLINE,
            (x, y, width, height)
        )

        # Than ong
        pygame.draw.rect(
            surface,
            PIPE_COLOR,
            (x + 3, y, width - 6, height)
        )

        # Anh sang ben trai
        pygame.draw.rect(
            surface,
            PIPE_LIGHT,
            (x + 7, y, 10, height)
        )

        # Bong toi ben phai
        pygame.draw.rect(
            surface,
            PIPE_DARK,
            (x + width - 14, y, 8, height)
        )

        pygame.draw.line(
            surface,
            (190, 240, 130),
            (x + 5, y),
            (x + 5, y + height),
            2
        )


    # =====================================
    # 6. VE MIENG ONG
    # =====================================
    def draw_pipe_cap(surface, x, y, is_top):
        x = int(x)
        y = int(y)

        cap_x = x - PIPE_CAP_EXTRA
        cap_width = PIPE_WIDTH + PIPE_CAP_EXTRA * 2

        cap_y = (
            y - PIPE_CAP_HEIGHT
            if is_top
            else y
        )

        pygame.draw.rect(
            surface,
            PIPE_OUTLINE,
            (cap_x, cap_y, cap_width, PIPE_CAP_HEIGHT)
        )

        pygame.draw.rect(
            surface,
            PIPE_COLOR,
            (
                cap_x + 3,
                cap_y + 3,
                cap_width - 6,
                PIPE_CAP_HEIGHT - 6
            )
        )

        pygame.draw.rect(
            surface,
            PIPE_LIGHT,
            (
                cap_x + 6,
                cap_y + 4,
                10,
                PIPE_CAP_HEIGHT - 8
            )
        )

        pygame.draw.rect(
            surface,
            PIPE_DARK,
            (
                cap_x + cap_width - 14,
                cap_y + 4,
                8,
                PIPE_CAP_HEIGHT - 8
            )
        )


    # =====================================
    # 7. TAO ONG
    # =====================================
    def create_pipe():
        gap_y = random.randint(160, GROUND_Y - 100)

        return {
            "x": float(WIDTH),
            "top": gap_y - PIPE_GAP // 2,
            "bottom": gap_y + PIPE_GAP // 2,
            "passed": False
        }


    def draw_pipes(surface, pipes):
        for pipe in pipes:
            x = int(pipe["x"])

            # Ong tren
            top_height = pipe["top"] - PIPE_CAP_HEIGHT

            draw_pipe_body(
                surface, x, 0,
                PIPE_WIDTH, top_height
            )

            draw_pipe_cap(
                surface, x, pipe["top"], True
            )

            # Ong duoi
            bottom_y = pipe["bottom"] + PIPE_CAP_HEIGHT
            bottom_height = GROUND_Y - bottom_y

            draw_pipe_body(
                surface, x, bottom_y,
                PIPE_WIDTH, bottom_height
            )

            draw_pipe_cap(
                surface, x, pipe["bottom"], False
            )


    # =====================================
    # 8. VE THANH PHO O XA
    # =====================================
    def draw_city(surface):
        buildings = [
            (0, 440, 28, 65),
            (32, 420, 24, 85),
            (60, 450, 34, 55),
            (100, 430, 25, 75),
            (130, 445, 36, 60),
            (172, 410, 28, 95),
            (205, 445, 32, 60),
            (244, 425, 25, 80),
            (275, 450, 35, 55),
            (315, 415, 30, 90),
            (350, 440, 25, 65),
            (380, 425, 30, 80)
        ]

        for x, y, width, height in buildings:
            pygame.draw.rect(
                surface,
                (105, 195, 225),
                (x, y, width, height)
            )

            # Cua so
            for wy in range(y + 10, y + height - 5, 15):
                for wx in range(x + 5, x + width - 3, 10):
                    pygame.draw.rect(
                        surface,
                        (145, 215, 235),
                        (wx, wy, 4, 6)
                    )


    # =====================================
    # 9. BUI CAY O XA
    # =====================================
    def draw_bushes(surface):
        bushes = [
            (0, 495, 40),
            (35, 485, 32),
            (70, 498, 38),
            (110, 486, 35),
            (150, 497, 40),
            (190, 488, 34),
            (230, 498, 42),
            (275, 485, 35),
            (315, 496, 40),
            (360, 488, 35),
            (395, 496, 40)
        ]

        for x, y, radius in bushes:
            pygame.draw.circle(
                surface,
                (95, 200, 125),
                (x, y),
                radius
            )

            pygame.draw.circle(
                surface,
                (75, 185, 110),
                (x + 12, y + 8),
                int(radius * 0.7)
            )


    # =====================================
    # 10. MAT DAT
    # =====================================
    def draw_ground(surface):
        # Lop co
        pygame.draw.rect(
            surface,
            (105, 205, 70),
            (0, GROUND_Y, WIDTH, 12)
        )

        pygame.draw.line(
            surface,
            (65, 155, 45),
            (0, GROUND_Y),
            (WIDTH, GROUND_Y),
            3
        )

        # Nen dat
        pygame.draw.rect(
            surface,
            (220, 185, 105),
            (
                0,
                GROUND_Y + 12,
                WIDTH,
                GROUND_HEIGHT - 12
            )
        )

        # Hoa tiet tren dat
        for x in range(0, WIDTH, 35):
            pygame.draw.line(
                surface,
                (195, 155, 85),
                (x, GROUND_Y + 22),
                (x + 12, GROUND_Y + 22),
                2
            )


    # =====================================
    # 11. LOP CHIM
    # =====================================
    class Bird:
        def __init__(self, x, y):
            self.x = float(x)
            self.y = float(y)

            self.velocity_y = 0.0
            self.gravity = 1200.0
            self.flap_strength = -380.0
            self.max_fall_speed = 600.0

            self.radius = 18
            self.wing_time = 0.0

        def flap(self):
            self.velocity_y = self.flap_strength

        def update(self, dt):
            self.velocity_y += self.gravity * dt

            self.velocity_y = min(
                self.velocity_y,
                self.max_fall_speed
            )

            self.y += self.velocity_y * dt
            self.wing_time += dt * 15

        def draw(self, surface):
            bird_surface = pygame.Surface(
                (70, 60),
                pygame.SRCALPHA
            )

            wing_y = math.sin(self.wing_time) * 5

            # Duoi
            pygame.draw.polygon(
                bird_surface,
                (245, 155, 30),
                [(12, 29), (2, 23), (5, 34)]
            )

            # Canh
            pygame.draw.ellipse(
                bird_surface,
                (210, 125, 25),
                (15, 29 + wing_y, 27, 17)
            )

            pygame.draw.ellipse(
                bird_surface,
                (255, 185, 45),
                (16, 27 + wing_y, 25, 15)
            )

            # Than
            pygame.draw.ellipse(
                bird_surface,
                (220, 135, 20),
                (10, 13, 43, 36)
            )

            pygame.draw.ellipse(
                bird_surface,
                (255, 205, 40),
                (10, 10, 42, 36)
            )

            # Bung
            pygame.draw.ellipse(
                bird_surface,
                (255, 240, 180),
                (21, 27, 25, 17)
            )

            # Ma
            pygame.draw.circle(
                bird_surface,
                (255, 135, 130),
                (42, 30),
                5
            )

            # Mat
            pygame.draw.ellipse(
                bird_surface,
                WHITE,
                (35, 15, 14, 17)
            )

            pygame.draw.circle(
                bird_surface,
                (45, 45, 55),
                (44, 23),
                4
            )

            pygame.draw.circle(
                bird_surface,
                WHITE,
                (45, 21),
                1
            )

            # Mo
            pygame.draw.polygon(
                bird_surface,
                (255, 115, 25),
                [(48, 29), (65, 33), (49, 37)]
            )

            # Vien than
            pygame.draw.ellipse(
                bird_surface,
                (175, 100, 20),
                (10, 10, 42, 36),
                2
            )

            angle = max(
                -25,
                min(65, self.velocity_y * 0.07)
            )

            rotated = pygame.transform.rotate(
                bird_surface,
                -angle
            )

            rect = rotated.get_rect(
                center=(int(self.x), int(self.y))
            )

            surface.blit(rotated, rect)


    # =====================================
    # 12. RESET GAME
    # =====================================
    bird = None
    pipes = []
    score = 0

    started = False
    game_over = False

    pipe_timer = 0.0
    elapsed_time = 0.0


    def reset_game():
        global bird, pipes, score
        global started, game_over
        global pipe_timer, elapsed_time

        bird = Bird(100, 250)
        pipes = []
        score = 0

        started = False
        game_over = False

        pipe_timer = 0.0
        elapsed_time = 0.0


    reset_game()


    # =====================================
    # 13. VONG LAP GAME
    # =====================================
    running = True

    while running:
        dt = min(clock.tick(FPS) / 1000.0, 0.05)

        # Su kien
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    running = False

                elif event.key == pygame.K_SPACE:
                    if game_over:
                        reset_game()
                    else:
                        started = True
                        bird.flap()

                elif event.key == pygame.K_r:
                    reset_game()

            elif event.type == pygame.MOUSEBUTTONDOWN:
                if event.button == 1:
                    if game_over:
                        reset_game()
                    else:
                        started = True
                        bird.flap()

        # Cap nhat game
        if started and not game_over:
            elapsed_time += dt

            current_pipe_speed = min(
                PIPE_SPEED_START
                + PIPE_SPEED_INCREASE * elapsed_time,
                PIPE_SPEED_MAX
            )

            bird.update(dt)

            pipe_timer += dt

            if pipe_timer >= PIPE_INTERVAL:
                pipes.append(create_pipe())
                pipe_timer -= PIPE_INTERVAL

            for pipe in pipes:
                pipe["x"] -= current_pipe_speed * dt

            pipes = [
                pipe for pipe in pipes
                if pipe["x"] + PIPE_WIDTH + PIPE_CAP_EXTRA > 0
            ]

            # Va cham tran va dat
            if bird.y - bird.radius <= 0:
                game_over = True

            if bird.y + bird.radius >= GROUND_Y:
                bird.y = GROUND_Y - bird.radius
                game_over = True

            # Va cham ong va tinh diem
            for pipe in pipes:
                bird_left = bird.x - bird.radius
                bird_right = bird.x + bird.radius
                bird_top = bird.y - bird.radius
                bird_bottom = bird.y + bird.radius

                pipe_left = pipe["x"] - PIPE_CAP_EXTRA
                pipe_right = (
                    pipe["x"] + PIPE_WIDTH + PIPE_CAP_EXTRA
                )

                overlaps_x = (
                    bird_right > pipe_left
                    and bird_left < pipe_right
                )

                outside_gap = (
                    bird_top < pipe["top"]
                    or bird_bottom > pipe["bottom"]
                )

                if overlaps_x and outside_gap:
                    game_over = True

                if (
                    not pipe["passed"]
                    and pipe_right < bird.x
                ):
                    pipe["passed"] = True
                    score += 1

        # =================================
        # VE CAC LOP PHONG CANH
        # =================================
        draw_background(screen)

        # May o lop xa
        update_and_draw_clouds(
            screen,
            dt,
            move=not game_over
        )

        # Thanh pho va cay o duoi chan troi
        draw_city(screen)
        draw_bushes(screen)

        # Ong nuoc
        draw_pipes(screen, pipes)

        # Mat dat
        draw_ground(screen)

        # Chim
        bird.draw(screen)

        # Diem
        score_text = big_font.render(
            str(score),
            True,
            WHITE
        )

        screen.blit(
            score_text,
            score_text.get_rect(
                center=(WIDTH // 2, 50)
            )
        )

        # Man hinh bat dau
        if not started and not game_over:
            message = font.render(
                "SPACE / Click to flap",
                True,
                WHITE
            )

            screen.blit(
                message,
                message.get_rect(
                    center=(WIDTH // 2, 130)
                )
            )

        # Game Over
        if game_over:
            overlay = pygame.Surface(
                (WIDTH, HEIGHT),
                pygame.SRCALPHA
            )

            overlay.fill((0, 0, 0, 110))
            screen.blit(overlay, (0, 0))

            title = big_font.render(
                "GAME OVER",
                True,
                WHITE
            )

            result = font.render(
                f"Score: {score}",
                True,
                WHITE
            )

            hint = font.render(
                "SPACE / Click to restart",
                True,
                WHITE
            )

            restart = font.render(
                "Press ESC to quit",
                True,
                WHITE
            )

            screen.blit(
                title,
                title.get_rect(
                    center=(WIDTH // 2, HEIGHT // 2 - 60)
                )
            )

            screen.blit(
                result,
                result.get_rect(
                    center=(WIDTH // 2, HEIGHT // 2 - 15)
                )
            )

            screen.blit(
                hint,
                hint.get_rect(
                    center=(WIDTH // 2, HEIGHT // 2 + 25)
                )
            )

            screen.blit(
                restart,
                restart.get_rect(
                    center=(WIDTH // 2, HEIGHT // 2 + 60)
                )
            )

        pygame.display.flip()

    pygame.quit()

