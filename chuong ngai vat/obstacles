def draw_pipes(surface, pipes):
    for pipe in pipes:
        # Ống phía trên
        pygame.draw.rect(
            surface,
            PIPE_COLOR,
            (
                pipe["x"],
                0,
                PIPE_WIDTH,
                pipe["top"]
            )
        )

        # Ống phía dưới
        pygame.draw.rect(
            surface,
            PIPE_COLOR,
            (
                pipe["x"],
                pipe["bottom"],
                PIPE_WIDTH,
                HEIGHT - pipe["bottom"]
            )
        )
